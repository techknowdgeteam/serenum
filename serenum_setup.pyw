        canvas.create_arc(38, 29, 50, 44, start=15, extent=150, style="arc", outline="#43D8FF", width=3)
        canvas.create_arc(55, 29, 68, 44, start=15, extent=150, style="arc", outline="#43D8FF", width=3)
        canvas.create_line(20, 36, 10, 36, fill="#42CFF8", width=4)
        canvas.create_line(84, 36, 94, 36, fill="#42CFF8", width=4)
        canvas.create_oval(8, 30, 20, 42, fill="#BFEFFF", outline="#2BC8F8", width=2)
