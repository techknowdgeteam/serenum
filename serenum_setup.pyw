        canvas.create_text(52, 80, text="S", fill="#44E2FF", font=("Segoe UI", 9, "bold"))

    def _center(self, width, height):
        self.root.update_idletasks()
        x = max(0, (self.root.winfo_screenwidth() - width) // 2)
        y = max(0, (self.root.winfo_screenheight() - height) // 2)
        self.root.geometry(f"{width}x{height}+{x}+{y}")

    def _emit(self, kind: str, **data):
        self.events.put((kind, data))

    def _write_log(self, line: str):
        self.install_log.append(line)
        self.install_log = self.install_log[-600:]
        try:
            self.log_file.parent.mkdir(parents=True, exist_ok=True)
            with self.log_file.open("a", encoding="utf-8") as handle:
                handle.write(line + "\n")
        except Exception:
            pass

    def _set_progress(self, value: int, status: str, message: str | None = None):
        self._emit("progress", value=max(0, min(100, int(value))), status=status, message=message)

    def _run_hidden_command(self, command: list[str], env: dict | None = None, cwd: Path | None = None):
        process = subprocess.Popen(
            command,
            cwd=str(cwd or INSTALL_DIR),
            env=env or os.environ.copy(),
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            encoding="utf-8",
            errors="replace",
            bufsize=1,
            creationflags=CREATE_NO_WINDOW,
        )
        captured = []
        assert process.stdout is not None
        for line in process.stdout:
            line = line.rstrip("\r\n")
            if line:
                captured.append(line)
                self._emit("log", line=line)
        code = process.wait()
        return code, captured

    def _install_layout(self):
        """Install Serenum and always create the exact AI cover GIF destination.

        The package deliberately does not require an ai_cover_assets folder.
        Supplied GIFs are read from the package root (or legacy locations), and
        an embedded robot GIF is written if all optional artwork is absent.
        """
        destination_script = INSTALL_DIR / "serenum.py"
        if not SOURCE_SCRIPT.is_file() and not destination_script.is_file():
            raise SetupFailure(
                "The Serenum application script is missing from both the setup package and installation folder. "
                "Extract the complete Serenum package again, then retry."
            )

        INSTALL_DIR.mkdir(parents=True, exist_ok=True)
        for folder in REQUIRED_DIRECTORIES:
            folder.mkdir(parents=True, exist_ok=True)

        same_directory = os.path.normcase(os.path.abspath(SOURCE_DIR)) == os.path.normcase(os.path.abspath(INSTALL_DIR))
        if SOURCE_SCRIPT.is_file() and not same_directory:
            self._copy_file(SOURCE_SCRIPT, destination_script)

        # Move the setup utility and launcher beside the installed application
        # so future starts can repair the installation from the same location.
        if not same_directory:
            for file_name in (SETUP_SCRIPT_NAME, LAUNCHER_NAME, "requirements-serenum.txt", "README_Serenum_Auto_Setup.txt"):
                source = SOURCE_DIR / file_name
                if source.is_file():
                    self._copy_file(source, INSTALL_DIR / file_name)

        # Copy optional artwork files from the flat package root or legacy
        # ai_cover_assets folder. The folder itself is never required.
        for file_name in COVER_SOURCE_NAMES:
            possible_sources = (
                SOURCE_DIR / file_name,
                SOURCE_DIR / "ai_cover_assets" / file_name,
                INSTALL_DIR / file_name,
                INSTALL_DIR / "ai_cover_assets" / file_name,
            )
            for source in possible_sources:
                if source.is_file():
                    target = INSTALL_DIR / file_name
                    if os.path.normcase(os.path.abspath(source)) != os.path.normcase(os.path.abspath(target)):
                        self._copy_file(source, target)
                    break

        # Create the user's required canonical cover file. Choose randomly from
        # valid available GIFs. If no supplied GIF exists, materialize the
        # embedded custom robot cover instead of failing setup.
        AI_COVER_DIR.mkdir(parents=True, exist_ok=True)
        cover_target = AI_COVER_DIR / COVER_OUTPUT_NAME
        candidates = []
        seen = set()
        source_locations = [SOURCE_DIR, INSTALL_DIR, AI_COVER_DIR]
        for base in source_locations:
            for file_name in COVER_SOURCE_NAMES:
                candidate = base / file_name
                key = os.path.normcase(os.path.abspath(candidate))
                if key in seen or not candidate.is_file() or candidate == cover_target:
                    continue
                seen.add(key)
                try:
                    with candidate.open("rb") as image_file:
                        header = image_file.read(6)
                    if header in (b"GIF87a", b"GIF89a") and candidate.stat().st_size > 256:
                        candidates.append(candidate)
                except OSError as exc:
                    self._write_log(f"Optional cover file could not be read: {candidate.name}: {exc}")

        if candidates:
            selected_cover = random.choice(candidates)
            temp_cover = cover_target.with_name(cover_target.name + ".tmp")
            shutil.copy2(selected_cover, temp_cover)
            os.replace(temp_cover, cover_target)
            self._write_log(f"Selected cover artwork: {selected_cover.name}")
        else:
            try:
                existing_valid = False
                if cover_target.is_file():
                    with cover_target.open("rb") as image_file:
                        existing_valid = image_file.read(6) in (b"GIF87a", b"GIF89a")
                if not existing_valid:
                    fallback_bytes = base64.b64decode(EMBEDDED_ROBOT_FALLBACK_GIF)
                    if not fallback_bytes.startswith((b"GIF87a", b"GIF89a")):
                        raise SetupFailure("The built-in Serenum robot cover data is invalid.")
                    temp_cover = cover_target.with_name(cover_target.name + ".tmp")
                    temp_cover.write_bytes(fallback_bytes)
                    os.replace(temp_cover, cover_target)
                self._write_log("No optional cover GIF was available. Created the built-in Serenum robot cover.")
            except Exception as exc:
                raise SetupFailure(
                    "Serenum could not create its required robot cover image. "
                    f"Check write permission for the AI cover folder. Details: {type(exc).__name__}: {exc}"
                ) from exc

        if not cover_target.is_file() or cover_target.stat().st_size < 256:
            raise SetupFailure("The required AI cover GIF could not be verified after creation.")

        # Preserve any existing author configuration. Never replace user data.
        config_file = INSTALL_DIR / "pageandgroupauthors.json"
        if config_file.exists():
            try:
                json.loads(config_file.read_text(encoding="utf-8"))
            except Exception as exc:
                self._write_log(f"Existing author configuration needs review: {type(exc).__name__}: {exc}")

        if not destination_script.is_file():
            raise SetupFailure("The Serenum application script could not be installed.")
    @staticmethod
    def _copy_file(source: Path, destination: Path):
        destination.parent.mkdir(parents=True, exist_ok=True)
        if os.path.normcase(os.path.abspath(source)) == os.path.normcase(os.path.abspath(destination)):
            return
        shutil.copy2(source, destination)

    def _extract_imports(self, script_path: Path) -> list[dict]:
        """Collect every direct module path and imported symbol from the script."""
        source = script_path.read_text(encoding="utf-8")
        tree = ast.parse(source, filename=str(script_path))
        targets = set()
        for node in ast.walk(tree):
            if isinstance(node, ast.Import):
                for alias in node.names:
                    targets.add((alias.name, None))
            elif isinstance(node, ast.ImportFrom) and node.module:
                for alias in node.names:
                    if alias.name != "*":
                        targets.add((node.module, alias.name))
                if not node.names:
                    targets.add((node.module, None))
        return [
            {"module": module, "member": member}
            for module, member in sorted(targets, key=lambda item: (item[0], item[1] or ""))
        ]

    def _module_root(self, module: str) -> str:
        return module.split(".", 1)[0]

    def _is_stdlib(self, module: str) -> bool:
        root = self._module_root(module)
        stdlib = getattr(sys, "stdlib_module_names", set())
        # imghdr is part of the supported Python 3.10–3.12 runtimes; it was
        # removed only in Python 3.13, which this setup intentionally rejects.
        return root in stdlib or root in sys.builtin_module_names or root == "imghdr"

    def _find_missing(self, imports: list[dict]):
        missing = []
        unknown = []
        checked_modules = set()
        for item in imports:
            module = item["module"]
            if module in checked_modules or self._is_stdlib(module):
                continue
            checked_modules.add(module)
            try:
                spec = importlib.util.find_spec(module)
            except (ImportError, ModuleNotFoundError, AttributeError, ValueError):
                spec = None
            if spec is None:
                distribution = PACKAGE_MAP.get(self._module_root(module))
                if distribution:
                    missing.append((module, distribution))
                else:
                    unknown.append(module)
        return missing, unknown

    def _ensure_pip(self):
        code, _ = self._run_hidden_command([self.python_console, "-m", "pip", "--version"])
        if code == 0:
            self._write_log("pip is available in the selected Python installation.")
            return
        self._write_log("pip is unavailable; enabling Python ensurepip.")
        code, output = self._run_hidden_command([self.python_console, "-m", "ensurepip", "--upgrade"])
        if code != 0:
            raise SetupFailure(
                "Python's package installer could not be enabled. Repair the Python installation and ensure pip is included. "
                + " | ".join(output[-8:])
            )

    def _pip_install(self, packages: list[str], force: bool = False):
        if not packages:
            return
        args = [
            self.python_console, "-m", "pip", "install",
            "--disable-pip-version-check", "--no-warn-script-location",
            "--progress-bar", "off", "--user",
        ]
        if force:
            args.extend(["--upgrade", "--force-reinstall"])
        args.extend(packages)
        self._write_log("Installing required libraries: " + ", ".join(packages))
        self._set_progress(58, "INSTALLING REQUIRED LIBRARIES", "Downloading missing libraries securely through Python's package installer.")
        code, output = self._run_hidden_command(args)
        if code != 0:
            raise SetupFailure(
                "One or more Python libraries could not be installed. Check your internet connection, then retry. "
                + " | ".join(output[-12:])
            )

    def _verify_imports(self, imports: list[dict]):
        # Test exact modules and imported symbols in a clean child interpreter.
        # This also catches native DLL errors and renamed/missing API members.
        payload = json.dumps(imports)
        code_text = (
            "import importlib,json,sys\n"
            f"items=json.loads({payload!r})\n"
            "bad=0\n"
            "for item in items:\n"
            " try:\n"
            "  member=item.get('member')\n"
            "  module=__import__(item['module'],fromlist=[member] if member else [])\n"
            "  if member: getattr(module,member)\n"
            "  label=item['module'] + ('.'+member if member else '')\n"
            "  print('IMPORT_OK\\t'+label,flush=True)\n"
            " except BaseException as exc:\n"
            "  bad+=1\n"
            "  label=item['module'] + ('.'+item['member'] if item.get('member') else '')\n"
            "  msg=str(exc).replace('\\\\','/').replace('\\n',' ')[:500]\n"
            "  print('IMPORT_FAIL\\t'+label+'\\t'+type(exc).__name__+'\\t'+msg,flush=True)\n"
            "sys.exit(1 if bad else 0)\n"
        )
        env = os.environ.copy()
        existing_pythonpath = env.get("PYTHONPATH", "")
        env["PYTHONPATH"] = str(INSTALL_DIR) + (os.pathsep + existing_pythonpath if existing_pythonpath else "")
        process = subprocess.Popen(
            [self.python_console, "-c", code_text],
            cwd=str(INSTALL_DIR),
            env=env,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            encoding="utf-8",
            errors="replace",
            bufsize=1,
            creationflags=CREATE_NO_WINDOW,
        )
        failures = []
        checked = 0
        total = max(1, len(imports))
        assert process.stdout is not None
        for raw in process.stdout:
            line = raw.rstrip("\r\n")
            if line.startswith("IMPORT_OK\t"):
                label = line.split("\t", 1)[1]
                checked += 1
                self._emit("log", line=f"Verified: {label}")
                pct = 60 + int((checked / total) * 35)
                self._set_progress(pct, "VERIFYING PYTHON MODULES", f"Checking import {checked} of {total}.")
            elif line.startswith("IMPORT_FAIL\t"):
                parts = line.split("\t", 3)
                label = parts[1] if len(parts) > 1 else "unknown"
                error_type = parts[2] if len(parts) > 2 else "ImportError"
                message = parts[3] if len(parts) > 3 else "Import failed"
                module = label.split(".", 1)[0]
                failures.append((module, label, error_type, message))
                checked += 1
                self._emit("log", line=f"Not verified: {label} — {error_type}: {message}")
                pct = 60 + int((checked / total) * 35)
                self._set_progress(pct, "VERIFYING PYTHON MODULES", f"Checking import {checked} of {total}.")
            elif line:
                self._emit("log", line=line)
        return_code = process.wait()
        return failures, return_code

    def _setup_background(self):
        try:
            self._write_log("Starting Serenum setup and validation.")
            self._set_progress(5, "PREPARING APPLICATION FOLDERS", "Creating required folders and installing application files.")
            self._install_layout()
            self._write_log("Application folders and cover assets are ready.")

            version = sys.version_info
            self._write_log(f"Python runtime detected: {version.major}.{version.minor}.{version.micro}")
            if not (version.major == 3 and 10 <= version.minor <= 12):
                raise SetupFailure(
                    f"This Serenum build requires Python 3.10, 3.11 or 3.12. The selected runtime is {version.major}.{version.minor}. "
                    "Install a supported Python version and launch Serenum again."
                )

            self._set_progress(18, "CHECKING PYTHON PACKAGE INSTALLER", "Confirming pip is available for automatic library setup.")
            self._ensure_pip()

            self._set_progress(28, "SCANNING SERENUM IMPORTS", "Reading every import used by the application.")
            modules = self._extract_imports(INSTALL_DIR / "serenum.py")
            self._write_log(f"Found {len(modules)} unique module and imported-symbol checks in serenum.py.")
            missing, unknown = self._find_missing(modules)
            if unknown:
                details = ", ".join(unknown)
                raise SetupFailure(
                    "The following application modules are not installed and have no safe package mapping: "
                    + details + ". Restore their local source files or add a verified package mapping before starting."
                )

            missing_packages = sorted({dist for _module, dist in missing}, key=str.lower)
            self._write_log(f"Missing import paths: {len(missing)}. Missing distributions: {len(missing_packages)}.")
            if missing_packages:
                self._set_progress(40, "DOWNLOADING MISSING LIBRARIES", f"Found {len(missing_packages)} libraries to install.")
                self._pip_install(missing_packages)

            # Verify all exact imported module paths. If an installed package is
            # present but its import fails (e.g. incomplete wheel/DLL), repair it
            # once, then run the full verification again.
            self._set_progress(60, "VERIFYING PYTHON MODULES", f"Testing {len(modules)} module and symbol imports.")
            failures, code = self._verify_imports(modules)
            if failures:
                repair = sorted({
                    PACKAGE_MAP.get(self._module_root(module))
                    for module, _label, _kind, _message in failures
                    if PACKAGE_MAP.get(self._module_root(module))
                }, key=str.lower)
                if repair:
                    self._write_log("Repairing packages with import errors: " + ", ".join(repair))
                    self._pip_install(repair, force=True)
                    failures, code = self._verify_imports(modules)
            if failures or code != 0:
                detail = "; ".join(f"{label}: {kind}: {msg}" for _m, label, kind, msg in failures[:10])
                raise SetupFailure(
                    "Some Python modules are still not importing correctly after repair. "
                    "Check the setup report and verify the matching Python installation. " + detail
                )

            # Syntax validation is performed without running the user's engines.
            source = (INSTALL_DIR / "serenum.py").read_text(encoding="utf-8")
            compile(source, str(INSTALL_DIR / "serenum.py"), "exec")
            self._set_progress(98, "FINALISING SERENUM", "All application imports and script checks passed.")
            self._write_log("All Python imports were verified successfully.")
            self._write_log("Serenum setup completed successfully.")
            self._emit("complete", message="All checks passed. Serenum is ready to open.")
        except BaseException as exc:
            payload = {
                "type": type(exc).__name__,
                "message": str(exc),
                "traceback": traceback.format_exc(),
            }
            self._write_log(f"SETUP FAILED: {payload['type']}: {payload['message']}")
            self._write_log(payload["traceback"])
            self._emit("failed", payload=payload)

    def start_setup(self):
        if self.started:
            return
        self.started = True
        self.copy_button.configure(state="normal")
        self.action_button.configure(text="CANCEL SETUP")
        self.thread = threading.Thread(target=self._setup_background, daemon=True)
        self.thread.start()

    def _poll_events(self):
        if not self.root.winfo_exists():
            return
        try:
            while True:
                kind, data = self.events.get_nowait()
                if kind == "log":
                    self._append_log(data.get("line", ""))
                elif kind == "progress":
                    value = data.get("value", 0)
                    self.progress.configure(value=value)
                    self.percent_label.configure(text=f"{value}%")
                    self.status_label.configure(text=data.get("status", "Working…"))
                    if data.get("message"):
                        self.subheading.configure(text=data["message"])
                elif kind == "complete":
                    self._show_complete(data.get("message", "Setup complete."))
                elif kind == "failed":
                    self._show_failure(data.get("payload", {}))
        except queue.Empty:
            pass
        self.root.after(100, self._poll_events)

    @staticmethod
    def _redact_for_screen(text: str) -> str:
        text = str(text)
        text = re.sub(r"(?i)(?<![A-Za-z0-9])(?:[A-Z]:\\|\\\\)[^\r\n<>|]+", "[installation detail hidden]", text)
        text = re.sub(r"(?<![A-Za-z0-9])/(?:[^\s<>|]+/)*[^\s<>|]+", "[installation detail hidden]", text)
        return text

    def _append_log(self, line: str):
        line = self._redact_for_screen(line)
        self.log_box.configure(state="normal")
        self.log_box.insert("end", line + "\n")
        self.log_box.see("end")
        # Keep the setup UI responsive and bounded.
        line_count = int(self.log_box.index("end-1c").split(".")[0])
        if line_count > 160:
            self.log_box.delete("1.0", f"{line_count - 130}.0")
        self.log_box.configure(state="disabled")

    def _show_complete(self, message: str):
        self.completed = True
        self.progress.configure(value=100)
        self.percent_label.configure(text="100%")
        self.status_label.configure(text="SETUP COMPLETE", fg=self.GREEN)
        self.heading.configure(text="Serenum is ready")
        self.subheading.configure(text=message + " Opening the main control center shortly.")
        self._append_log("SUCCESS — Environment confirmed. Opening Serenum…")
        self.action_button.configure(
            text="OPEN SERENUM NOW", command=self.open_serenum,
            bg="#0B704A", fg="#FFFFFF", state="normal",
        )
        self.root.after(1800, self.open_serenum)

    def _show_failure(self, payload: dict):
        self.failed = True
        self.status_label.configure(text="SETUP NEEDS ATTENTION", fg=self.RED)
        self.heading.configure(text="Setup could not be completed")
        self.subheading.configure(
            text="Serenum has not been opened because one or more checks failed. Review the message below, correct the issue, and retry."
        )
        self.progress.configure(value=100)
        self.percent_label.configure(text="CHECK FAILED")
        self._append_log(f"ERROR — {payload.get('type', 'Setup error')}: {payload.get('message', 'Unknown setup error')}")
        self.action_button.configure(
            text="RETRY SETUP", command=self.retry_setup,
            bg="#173D36", fg=self.GREEN, state="normal",
        )
        self.copy_button.configure(state="normal")
        messagebox.showerror(
            "Serenum setup needs attention",
            self._redact_for_screen(payload.get("message") or "Setup could not be completed. Copy the setup report for full diagnostics."),
            parent=self.root,
        )

    def retry_setup(self):
        self.started = False
        self.completed = False
        self.failed = False
        self.progress.configure(value=0)
        self.percent_label.configure(text="0%")
        self.status_label.configure(text="Retrying setup…", fg=self.GREEN)
        self.heading.configure(text="Preparing Serenum")
        self.subheading.configure(text="Checking the application, Python libraries and required folders.")
        self.log_box.configure(state="normal")
        self.log_box.delete("1.0", "end")
        self.log_box.configure(state="disabled")
        self.action_button.configure(text="CANCEL SETUP", command=self.close, bg="#1A2A3D", fg=self.MUTED)
        self.start_setup()

    def open_serenum(self):
        if not self.completed:
            return
        try:
            app_path = INSTALL_DIR / "serenum.py"
            if not app_path.is_file():
                raise FileNotFoundError("The main Serenum script is not installed.")
            env = os.environ.copy()
            env["PYTHONIOENCODING"] = "utf-8"
            subprocess.Popen(
                [sys.executable, "-X", "utf8", str(app_path)],
                cwd=str(INSTALL_DIR),
                env=env,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                creationflags=CREATE_NO_WINDOW,
                close_fds=True,
            )
            self.root.destroy()
        except Exception as exc:
            self.failed = True
            messagebox.showerror(
                "Could not open Serenum",
                f"The environment check passed, but the main window could not be opened.\n\n{type(exc).__name__}: {exc}",
                parent=self.root,
            )

    def copy_report(self):
        try:
            report = "\n".join(self._redact_for_screen(line) for line in self.install_log) or "No setup output has been recorded yet."
            self.root.clipboard_clear()
            self.root.clipboard_append(report)
            self.root.update_idletasks()
            self.status_label.configure(text="SETUP REPORT COPIED", fg=self.GREEN)
        except Exception as exc:
            messagebox.showerror("Copy failed", str(exc), parent=self.root)

    def close(self):
        if self.thread and self.thread.is_alive() and not self.completed and not self.failed:
            if not messagebox.askyesno("Cancel setup?", "Setup is still running. Cancel and close this window?", parent=self.root):
                return
        try:
            self.root.destroy()
        except Exception:
            pass


def main():
    if sys.platform != "win32":
        raise SystemExit("Serenum setup is designed for Windows.")
    root = tk.Tk()
    SerenumSetup(root)
    root.mainloop()


if __name__ == "__main__":
    main()
