class SetupFailure(RuntimeError):
    pass


class SerenumSetup:
    BG = "#07111F"
    PANEL = "#0D1B2D"
    PANEL2 = "#10243A"
    BORDER = "#1E4968"
    TEXT = "#EAF5FF"
    MUTED = "#9BB4C9"
    CYAN = "#24C8F5"
    GREEN = "#31D58A"
    RED = "#FF657A"

    def __init__(self, root: tk.Tk):
        self.root = root
        self.events: queue.Queue = queue.Queue()
        self.thread: threading.Thread | None = None
        self.started = False
        self.completed = False
        self.failed = False
        self.install_log: list[str] = []
        self.log_file = INSTALL_DIR / "serenum_setup.log"
        self.main_script = INSTALL_DIR / "serenum.py"
        self.python_console = self._python_console_executable()
        self._build_ui()
        self.root.protocol("WM_DELETE_WINDOW", self.close)
        self.root.after(100, self._poll_events)
        self.root.after(350, self.start_setup)

    def _python_console_executable(self) -> str:
        exe = Path(sys.executable)
        if exe.name.lower() == "pythonw.exe":
            sibling = exe.with_name("python.exe")
            if sibling.is_file():
                return str(sibling)
        return str(exe)

    def _build_ui(self):
        self.root.title("Serenum • First-Run Setup")
        self.root.configure(bg=self.BG)
        self.root.geometry("760x540")
        self.root.minsize(680, 480)
        self._center(760, 540)

        style = ttk.Style(self.root)
        try:
            style.theme_use("clam")
        except Exception:
            pass
        style.configure(
            "Serenum.Green.Horizontal.TProgressbar",
            troughcolor="#173049", background=self.GREEN,
            bordercolor="#173049", lightcolor=self.GREEN,
            darkcolor=self.GREEN, thickness=13,
        )

        outer = tk.Frame(self.root, bg=self.BG)
        outer.pack(fill="both", expand=True, padx=22, pady=18)

        header = tk.Frame(outer, bg=self.BG)
        header.pack(fill="x")
        brand = tk.Label(
            header, text="S", bg="#073A5B", fg=self.CYAN,
            font=("Segoe UI", 22, "bold"), width=2, height=1,
        )
        brand.pack(side="left", padx=(0, 12))
        brand_text = tk.Frame(header, bg=self.BG)
        brand_text.pack(side="left", fill="y")
        tk.Label(
            brand_text, text="SERENUM", bg=self.BG, fg=self.TEXT,
            font=("Segoe UI", 19, "bold"),
        ).pack(anchor="w")
        tk.Label(
